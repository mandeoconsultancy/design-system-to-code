{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "design-system": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "frameworks/angular",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/design-system",
            "index": "frameworks/angular/index.html",
            "main": "frameworks/angular/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": ["frameworks/angular/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true
            }
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "browserTarget": "design-system:build",
            "configDir": ".storybook-angular",
            "tsConfig": "tsconfig.storybook.json",
            "compodoc": false,
            "port": 6007
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "browserTarget": "design-system:build",
            "configDir": ".storybook-angular",
            "tsConfig": "tsconfig.storybook.json",
            "outputDir": "storybook-static-angular",
            "compodoc": false
          }
        }
      }
    }
  }
}
